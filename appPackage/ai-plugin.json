{
    "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
    "schema_version": "v2.4",
    "name_for_human": "Bot IQ Core Admin API",
    "description_for_human": "APIs for admin tasks including user validation and transaction log summarization.",
    "description_for_model": "APIs for admin tasks including user validation and transaction log summarization.",
    "contact_email": "publisher-email@example.com",
    "namespace": "summarizelogdeclarative",
    "capabilities": {},
    "functions": [
        {
            "name": "summarizeTransactionLog",
            "description": "Retrieves a summary of transaction log details with optional filters and grouping.",
            "capabilities": {
                "response_semantics": {
                    "data_path": "$",
                    "properties": {
                        "title": "$.status_code",
                        "subtitle": "$.status_description"
                    },
                    "static_template": {
                        "file": "adaptiveCards/summarizeTransactionLog1.json"
                    }
                }
            }
        }
    ],
    "runtimes": [
        {
            "type": "OpenApi",
            "auth": {
                "type": "ApiKeyPluginVault",
                "reference_id": "${{AUTHORIZE_TOKEN_AUTH_REGISTRATION_ID}}"
            },
            "spec": {
                "url": "apiSpecificationFile/openapi.yaml"
            },
            "run_for_functions": [
                "summarizeTransactionLog"
            ]
        }
    ]
}
