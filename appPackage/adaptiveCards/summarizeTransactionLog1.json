{
    "type": "AdaptiveCard",
    "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
        {
            "type": "Container",
            "items": [
                {
                    "type": "TextBlock",
                    "text": "Transaction Log Summary",
                    "weight": "Bolder",
                    "size": "Medium"
                },
                {
                    "type": "TextBlock",
                    "text": "${if(status_code == 200, status_description, error_message)}",
                    "isSubtle": true,
                    "wrap": true
                }
            ]
        },
        {
            "type": "FactSet",
            "facts": [
                {
                    "title": "Total Transactions:",
                    "value": "${if(response_body.summary.matching_transaction_count, response_body.summary.matching_transaction_count, '0')}"
                },
                {
                    "title": "Passed:",
                    "value": "${if(response_body.summary.passed, response_body.summary.passed, '0')}"
                },
                {
                    "title": "Failed:",
                    "value": "${if(response_body.summary.failed, response_body.summary.failed, '0')}"
                },
                {
                    "title": "Failure Rate:",
                    "value": "${if(response_body.summary.failure_rate_pct, response_body.summary.failure_rate_pct, '0')}%"
                },
                {
                    "title": "Input Tokens:",
                    "value": "${if(response_body.summary.total_input_tokens, response_body.summary.total_input_tokens, '0')}"
                },
                {
                    "title": "Output Tokens:",
                    "value": "${if(response_body.summary.total_output_tokens, response_body.summary.total_output_tokens, '0')}"
                },
                {
                    "title": "Avg Latency (ms):",
                    "value": "${if(response_body.summary.avg_latency_ms, response_body.summary.avg_latency_ms, '0')}"
                }
            ],
            "$when": "${response_body != null && response_body.summary != null}"
        }
    ]
}
