{
    "type": "AdaptiveCard",
    "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
        {
            "type": "Container",
            "items": [
                {
                    "type": "TextBlock",
                    "text": "User Validation",
                    "weight": "Bolder",
                    "size": "Medium"
                },
                {
                    "type": "TextBlock",
                    "text": "${if(status_code == 200, 'Success', error_message)}",
                    "color": "${if(status_code == 200, 'Good', 'Attention')}",
                    "wrap": true
                }
            ]
        },
        {
            "type": "TextBlock",
            "text": "Token generated successfully.",
            "isSubtle": true,
            "$when": "${response_body != null && response_body.authorize_token != null}"
        }
    ]
}
